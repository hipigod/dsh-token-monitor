{
  "name": "@local/dsh-token-monitor",
  "version": "0.1.0",
  "description": "模型 Token 用量监测 · 在 DSH 侧边栏底部（设置按钮上方）显示当前模型的当日 token 总量与每小时直方图，并提供可查询今日/近一周/近一月/自定义区间的用量日志弹窗",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "token",
    "usage",
    "monitor"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hipigod/dsh-token-monitor.git"
  },
  "homepage": "https://github.com/hipigod/dsh-token-monitor#readme",
  "bugs": {
    "url": "https://github.com/hipigod/dsh-token-monitor/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
